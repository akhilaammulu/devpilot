type Query {
    currentUser: User
    repositories: [Repository!]!
    repository(id: ID!): Repository
    scans(repositoryId: ID!): [RepositoryScan!]!
    scan(id: ID!): RepositoryScan
    issues(scanId: ID!, category: IssueCategory, severity: IssueSeverity, engine: String, status: String): [Issue!]!
    qualityMetrics(scanId: ID!): QualityMetrics!
    securityMetrics(scanId: ID!): SecurityMetrics!
    accessibilityMetrics(scanId: ID!): AccessibilityMetrics!
    explainIssue(issueId: ID!): AiIssueAnalysis!
    askRepository(repositoryId: ID!, query: String!): RagAnswer!
    repositoryIndexStatus(repositoryId: ID!): RepositoryIndexResult
}

type Mutation {
    connectRepository(input: ConnectRepositoryInput!): Repository!
    startScan(input: StartScanInput!): RepositoryScan!
    startSecurityScan(input: StartScanInput!): RepositoryScan!
    startAccessibilityScan(input: StartScanInput!): RepositoryScan!
    generateAiAnalysis(issueId: ID!): AiIssueAnalysis!
    generateBulkAiAnalysis(scanId: ID!): [AiIssueAnalysis!]!
    indexRepository(repositoryId: ID!): RepositoryIndexResult!
    updateIssueStatus(id: ID!, status: String!): Issue!
}

input ConnectRepositoryInput {
    githubRepoId: String!
    fullName: String!
    defaultBranch: String!
    isPrivate: Boolean!
    htmlUrl: String!
}

input StartScanInput {
    repositoryId: ID!
    branchName: String!
    commitSha: String!
}

type User {
    id: ID!
    githubUserId: String!
    username: String!
    email: String
    avatarUrl: String
    createdAt: String!
}

type Repository {
    id: ID!
    githubRepoId: String!
    fullName: String!
    defaultBranch: String!
    isPrivate: Boolean!
    htmlUrl: String!
    connectedAt: String!
    scans: [RepositoryScan!]!
}

enum ScanStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
}

type RepositoryScan {
    id: ID!
    repository: Repository!
    commitSha: String!
    branchName: String!
    status: ScanStatus!
    qualityScore: Int
    securityScore: Int
    accessibilityScore: Int
    startedAt: String!
    completedAt: String
    engineReports: [EngineExecutionReport!]
    issues: [Issue!]!
}

enum IssueCategory {
    CODE_QUALITY
    SECURITY
    ACCESSIBILITY
}

enum IssueSeverity {
    CRITICAL
    HIGH
    MEDIUM
    LOW
}

type Issue {
    id: ID!
    repositoryId: ID
    scanId: ID
    category: IssueCategory!
    severity: IssueSeverity!
    ruleId: String!
    filePath: String!
    lineStart: Int
    lineEnd: Int
    startLine: Int
    endLine: Int
    startColumn: Int
    endColumn: Int
    message: String!
    snippet: String
    aiExplanation: String
    aiFixSuggestion: String
    aiWhyItMatters: String
    aiSuggestedUnitTest: String
    aiModelUsed: String
    engine: String
    status: String
    language: String
    createdAt: String!
}

type EngineExecutionReport {
    engine: String!
    status: String!
    findingsCount: Int!
    executionTimeMs: Int!
    message: String
}

type QualityMetrics {
    qualityScore: Int!
    grade: String!
    maintainabilityScore: Int!
    cyclomaticComplexity: Float!
    openIssuesCount: Int!
    resolvedIssuesCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
}

type SecurityMetrics {
    securityScore: Int!
    grade: String!
    openVulnerabilitiesCount: Int!
    resolvedVulnerabilitiesCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
    dependencyIssuesCount: Int!
    secretLeaksCount: Int!
    configurationIssuesCount: Int!
}

type AccessibilityMetrics {
    accessibilityScore: Int!
    grade: String!
    wcagLevel: String!
    openViolationsCount: Int!
    resolvedViolationsCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
    perceivableCount: Int!
    operableCount: Int!
    understandableCount: Int!
    robustCount: Int!
}

type PullRequest {
    id: ID!
    repository: Repository!
    githubPrNumber: Int!
    title: String!
    sourceBranch: String!
    targetBranch: String!
    headSha: String!
    state: String!
    openedAt: String!
    updatedAt: String!
}

type AiIssueAnalysis {
    issueId: ID!
    ruleId: String!
    title: String!
    whyItMatters: String!
    remediationGuidance: String!
    codeFix: String!
    suggestedUnitTest: String!
    confidenceScore: Float!
    modelUsed: String!
    createdAt: String!
}

type RagAnswer {
    query: String!
    answer: String!
    confidenceScore: Float!
    sources: [RagSourceCitation!]!
    modelUsed: String!
    createdAt: String!
}

type RagSourceCitation {
    filePath: String!
    startLine: Int!
    endLine: Int!
    snippet: String!
    relevanceScore: Float!
    symbolName: String
}

type RepositoryIndexResult {
    repositoryId: ID!
    filesIndexed: Int!
    chunksCreated: Int!
    status: String!
    indexedAt: String!
}
