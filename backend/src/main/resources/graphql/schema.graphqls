type Query {
    currentUser: User
    repositories: [Repository!]!
    repository(id: ID!): Repository
    scans(repositoryId: ID!): [RepositoryScan!]!
    scan(id: ID!): RepositoryScan
    issues(scanId: ID!, category: IssueCategory, severity: IssueSeverity, engine: String, status: String): [Issue!]!
    qualityMetrics(scanId: ID!): QualityMetrics!
    securityMetrics(scanId: ID!): SecurityMetrics!
    accessibilityMetrics(scanId: ID!): AccessibilityMetrics!
    explainIssue(issueId: ID!): AiIssueAnalysis!
    askRepository(repositoryId: ID!, query: String!): RagAnswer!
    repositoryIndexStatus(repositoryId: ID!): RepositoryIndexResult
    pullRequests(repositoryId: ID!): [PullRequest!]!
    pullRequest(id: ID!): PullRequest
    pipelines(repositoryId: ID!): [PipelineConfig!]!
    pipelineRuns(repositoryId: ID!, pipelineConfigId: ID): [PipelineRun!]!
    pipelineRun(id: ID!): PipelineRun
    pipelineDeployments(repositoryId: ID!): [PipelineDeployment!]!
    pipelineSecrets(repositoryId: ID!): [PipelineSecretMeta!]!
    pipelineMetrics(repositoryId: ID!): PipelineMetrics!
    scanEvents(scanId: ID): [ScanEventRecord!]!
    deadLetterEvents: [ScanEventRecord!]!
}

type Mutation {
    connectRepository(input: ConnectRepositoryInput!): Repository!
    startScan(input: StartScanInput!): RepositoryScan!
    startAsyncScan(input: StartScanInput!): RepositoryScan!
    startSecurityScan(input: StartScanInput!): RepositoryScan!
    startAccessibilityScan(input: StartScanInput!): RepositoryScan!
    generateAiAnalysis(issueId: ID!): AiIssueAnalysis!
    generateBulkAiAnalysis(scanId: ID!): [AiIssueAnalysis!]!
    indexRepository(repositoryId: ID!): RepositoryIndexResult!
    updateIssueStatus(id: ID!, status: String!): Issue!
    analyzePullRequest(pullRequestId: ID!): PullRequest!
    triggerPullRequestAnalysis(input: TriggerPullRequestInput!): PullRequest!
    postPrReviewComment(pullRequestId: ID!): PullRequest!
    createPipeline(input: CreatePipelineInput!): PipelineConfig!
    updatePipelineStages(pipelineId: ID!, stages: [StageDefinitionInput!]!): PipelineConfig!
    runPipeline(pipelineId: ID!, triggerType: String, commitSha: String): PipelineRun!
    retryPipelineStage(runId: ID!, stageName: String!): PipelineRun!
    cancelPipelineRun(runId: ID!): PipelineRun!
    deployPipelineRun(runId: ID!, environment: String!): PipelineDeployment!
    rollbackDeployment(deploymentId: ID!): PipelineDeployment!
    savePipelineSecret(repositoryId: ID!, name: String!, value: String!, scope: String): PipelineSecretMeta!
    deletePipelineSecret(secretId: ID!): Boolean!
    retryDeadLetterEvent(eventId: ID!): ScanEventRecord!
}

input ConnectRepositoryInput {
    githubRepoId: String!
    fullName: String!
    defaultBranch: String!
    isPrivate: Boolean!
    htmlUrl: String!
}

input StartScanInput {
    repositoryId: ID!
    branchName: String!
    commitSha: String!
}

type User {
    id: ID!
    githubUserId: String!
    username: String!
    email: String
    avatarUrl: String
    createdAt: String!
}

type Repository {
    id: ID!
    githubRepoId: String!
    fullName: String!
    defaultBranch: String!
    isPrivate: Boolean!
    htmlUrl: String!
    connectedAt: String!
    scans: [RepositoryScan!]!
}

enum ScanStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
}

type RepositoryScan {
    id: ID!
    repository: Repository!
    commitSha: String!
    branchName: String!
    status: ScanStatus!
    qualityScore: Int
    securityScore: Int
    accessibilityScore: Int
    startedAt: String!
    completedAt: String
    engineReports: [EngineExecutionReport!]
    issues: [Issue!]!
}

enum IssueCategory {
    CODE_QUALITY
    SECURITY
    ACCESSIBILITY
}

enum IssueSeverity {
    CRITICAL
    HIGH
    MEDIUM
    LOW
}

type Issue {
    id: ID!
    repositoryId: ID
    scanId: ID
    category: IssueCategory!
    severity: IssueSeverity!
    ruleId: String!
    filePath: String!
    lineStart: Int
    lineEnd: Int
    startLine: Int
    endLine: Int
    startColumn: Int
    endColumn: Int
    message: String!
    snippet: String
    aiExplanation: String
    aiFixSuggestion: String
    aiWhyItMatters: String
    aiSuggestedUnitTest: String
    aiModelUsed: String
    engine: String
    status: String
    language: String
    createdAt: String!
}

type EngineExecutionReport {
    engine: String!
    status: String!
    findingsCount: Int!
    executionTimeMs: Int!
    message: String
}

type QualityMetrics {
    qualityScore: Int!
    grade: String!
    maintainabilityScore: Int!
    cyclomaticComplexity: Float!
    openIssuesCount: Int!
    resolvedIssuesCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
}

type SecurityMetrics {
    securityScore: Int!
    grade: String!
    openVulnerabilitiesCount: Int!
    resolvedVulnerabilitiesCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
    dependencyIssuesCount: Int!
    secretLeaksCount: Int!
    configurationIssuesCount: Int!
}

type AccessibilityMetrics {
    accessibilityScore: Int!
    grade: String!
    wcagLevel: String!
    openViolationsCount: Int!
    resolvedViolationsCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
    perceivableCount: Int!
    operableCount: Int!
    understandableCount: Int!
    robustCount: Int!
}

input TriggerPullRequestInput {
    repositoryId: ID!
    prNumber: Int!
    title: String!
    author: String
    sourceBranch: String!
    targetBranch: String!
    headSha: String!
    changedFiles: [String!]
    postComment: Boolean
}

type PullRequest {
    id: ID!
    repository: Repository!
    githubPrNumber: Int!
    title: String!
    author: String
    sourceBranch: String!
    targetBranch: String!
    headSha: String!
    state: String!
    prScore: Int
    qualityScore: Int
    securityScore: Int
    accessibilityScore: Int
    reviewStatus: String
    reviewSummary: String
    changedFilesCount: Int
    changedFiles: [String!]!
    findingsCount: Int
    githubCommentPosted: Boolean
    githubCommentUrl: String
    lastAnalyzedAt: String
    openedAt: String!
    updatedAt: String!
    history: [PullRequestReviewHistory!]!
}

type PullRequestReviewHistory {
    id: ID!
    pullRequestId: ID!
    commitSha: String!
    prScore: Int!
    qualityScore: Int!
    securityScore: Int!
    accessibilityScore: Int!
    findingsCount: Int!
    reviewStatus: String!
    reviewSummary: String
    githubCommentPosted: Boolean!
    createdAt: String!
}

type AiIssueAnalysis {
    issueId: ID!
    ruleId: String!
    title: String!
    whyItMatters: String!
    remediationGuidance: String!
    codeFix: String!
    suggestedUnitTest: String!
    confidenceScore: Float!
    modelUsed: String!
    createdAt: String!
}

type RagAnswer {
    query: String!
    answer: String!
    confidenceScore: Float!
    sources: [RagSourceCitation!]!
    modelUsed: String!
    createdAt: String!
}

type RagSourceCitation {
    filePath: String!
    startLine: Int!
    endLine: Int!
    snippet: String!
    relevanceScore: Float!
    symbolName: String
}

type RepositoryIndexResult {
    repositoryId: ID!
    filesIndexed: Int!
    chunksCreated: Int!
    status: String!
    indexedAt: String!
}

input StageDefinitionInput {
    name: String!
    type: String!
    command: String!
    enabled: Boolean
}

input QualityGateInput {
    maxCritical: Int
    maxHigh: Int
    minCoverage: Int
    requireBuildPass: Boolean
    requireSecurityPass: Boolean
}

input CreatePipelineInput {
    repositoryId: ID!
    name: String!
    branch: String!
    language: String!
    buildTool: String!
    testFramework: String!
    environment: String!
    deploymentTarget: String!
    triggers: [String!]
    stages: [StageDefinitionInput!]
    qualityGate: QualityGateInput
}

type StageDefinition {
    name: String!
    type: String!
    command: String!
    enabled: Boolean!
}

type QualityGateConfig {
    maxCritical: Int!
    maxHigh: Int!
    minCoverage: Int!
    requireBuildPass: Boolean!
    requireSecurityPass: Boolean!
}

type PipelineConfig {
    id: ID!
    repositoryId: ID!
    name: String!
    branch: String!
    language: String!
    buildTool: String!
    testFramework: String!
    environment: String!
    deploymentTarget: String!
    triggers: [String!]!
    stages: [StageDefinition!]!
    qualityGate: QualityGateConfig!
    createdAt: String!
    updatedAt: String!
}

type PipelineStageResult {
    name: String!
    type: String!
    status: String!
    durationMs: Int!
    errorsCount: Int!
    warningsCount: Int!
    qualityScore: Int
    artifacts: [String!]!
    command: String
}

type PipelineLogEntry {
    timestamp: String!
    stage: String!
    level: String!
    command: String
    message: String!
}

type PipelineRun {
    id: ID!
    pipelineConfigId: ID!
    repositoryId: ID!
    runNumber: Int!
    pipelineName: String!
    branch: String!
    commitSha: String!
    triggerType: String!
    status: String!
    qualityScore: Int
    securityScore: Int
    testCoverage: Int
    qualityGatePassed: Boolean
    qualityGateReason: String
    durationMs: Int!
    stages: [PipelineStageResult!]!
    logs: [PipelineLogEntry!]!
    startedAt: String!
    completedAt: String
}

type PipelineDeployment {
    id: ID!
    pipelineRunId: ID!
    repositoryId: ID!
    environment: String!
    version: String!
    commitSha: String!
    status: String!
    deployedBy: String!
    rolledBackFromId: ID
    deployedAt: String!
}

type PipelineSecretMeta {
    id: ID!
    repositoryId: ID!
    name: String!
    maskedValue: String!
    scope: String!
    createdAt: String!
}

type PipelineMetrics {
    totalPipelines: Int!
    runningPipelines: Int!
    successfulPipelines: Int!
    failedPipelines: Int!
    successRate: Int!
    avgDurationMs: Int!
    latestDeploymentStatus: String!
    latestDeploymentEnv: String!
}

type ScanEventRecord {
    id: ID!
    scanId: ID!
    repositoryId: ID!
    eventType: String!
    correlationId: String!
    payloadJson: String
    status: String!
    retryCount: Int!
    errorMessage: String
    createdAt: String!
    processedAt: String
}
