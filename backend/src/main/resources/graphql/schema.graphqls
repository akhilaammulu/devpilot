type Query {
    currentUser: User
    repositories: [Repository!]!
    repository(id: ID!): Repository
    scans(repositoryId: ID!): [RepositoryScan!]!
    scan(id: ID!): RepositoryScan
    issues(scanId: ID!, severity: IssueSeverity, engine: String, status: String): [Issue!]!
    qualityMetrics(scanId: ID!): QualityMetrics!
}

type Mutation {
    connectRepository(input: ConnectRepositoryInput!): Repository!
    startScan(input: StartScanInput!): RepositoryScan!
    updateIssueStatus(id: ID!, status: String!): Issue!
}

input ConnectRepositoryInput {
    githubRepoId: String!
    fullName: String!
    defaultBranch: String!
    isPrivate: Boolean!
    htmlUrl: String!
}

input StartScanInput {
    repositoryId: ID!
    branchName: String!
    commitSha: String!
}

type User {
    id: ID!
    githubUserId: String!
    username: String!
    email: String
    avatarUrl: String
    createdAt: String!
}

type Repository {
    id: ID!
    githubRepoId: String!
    fullName: String!
    defaultBranch: String!
    isPrivate: Boolean!
    htmlUrl: String!
    connectedAt: String!
    scans: [RepositoryScan!]!
}

enum ScanStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
}

type RepositoryScan {
    id: ID!
    repository: Repository!
    commitSha: String!
    branchName: String!
    status: ScanStatus!
    qualityScore: Int
    securityScore: Int
    accessibilityScore: Int
    startedAt: String!
    completedAt: String
    issues: [Issue!]!
}

enum IssueCategory {
    CODE_QUALITY
    SECURITY
    ACCESSIBILITY
}

enum IssueSeverity {
    CRITICAL
    HIGH
    MEDIUM
    LOW
}

type Issue {
    id: ID!
    category: IssueCategory!
    severity: IssueSeverity!
    ruleId: String!
    filePath: String!
    lineStart: Int
    lineEnd: Int
    message: String!
    snippet: String
    aiExplanation: String
    aiFixSuggestion: String
    engine: String
    status: String
    language: String
    createdAt: String!
}

type QualityMetrics {
    qualityScore: Int!
    grade: String!
    maintainabilityScore: Int!
    cyclomaticComplexity: Float!
    openIssuesCount: Int!
    resolvedIssuesCount: Int!
    criticalCount: Int!
    highCount: Int!
    mediumCount: Int!
    lowCount: Int!
}

type PullRequest {
    id: ID!
    repository: Repository!
    githubPrNumber: Int!
    title: String!
    sourceBranch: String!
    targetBranch: String!
    headSha: String!
    state: String!
    openedAt: String!
    updatedAt: String!
}
